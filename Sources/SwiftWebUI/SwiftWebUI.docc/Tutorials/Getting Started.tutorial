@Tutorial(time: 5) {
    @Intro(title: "Build a SwiftWebUI screen") {
        A three-step walkthrough that goes from a fresh SwiftPM
        package to `Text("Hello, web")` rendered in a browser.

        Steps 2 and 3 describe the 0.1.0 end state. Until the
        renderer and bridge ship, the Swift code in this tutorial
        compiles against the public surface but is not yet rendered
        to the DOM.
    }

    @Section(title: "Create a SwiftWebUI app") {
        @ContentAndMedia {
            A SwiftWebUI app starts as a SwiftPM executable that
            depends on the `SwiftWebUI` product and links the
            `wasm32-unknown-wasi` target.

            The `Package.swift` shipped in the repository is the
            single source of truth for the dependency, products,
            and target matrix. `swift build` compiles the host
            targets for unit tests; `swift build --triple
            wasm32-unknown-wasi` produces the wasm binary that
            runs in the browser.

            `./scripts/serve.sh` builds the wasm, bundles the JS
            shim, and serves the host page on `localhost`.

            @Image(source: "placeholder.png", alt: "A blank host page served on localhost.")
        }

        @Steps {
            @Step {
                Add the `SwiftWebUI` product to the package's
                dependencies and import it from the executable
                target.

                @Code(name: "Package.swift", file: "package.swift") {
                    let package = Package(
                        name: "HelloWeb",
                        products: [
                            .executable(name: "HelloWeb", targets: ["HelloWeb"])
                        ],
                        dependencies: [
                            .package(url: "https://github.com/ATZLab/swift-web-ui", from: "0.1.0")
                        ],
                        targets: [
                            .executableTarget(
                                name: "HelloWeb",
                                dependencies: [
                                    .product(name: "SwiftWebUI", package: "swift-web-ui")
                                ]
                            )
                        ]
                    )
                }
            }

            @Step {
                Build the wasm target.

                @Code(name: "Terminal", file: "build-wasm.txt") {
                    swift build --triple wasm32-unknown-wasi
                }
            }

            @Step {
                Serve the host page.

                @Code(name: "Terminal", file: "serve.txt") {
                    ./scripts/serve.sh
                }
            }
        }
    }

    @Section(title: "Add a Text view") {
        @ContentAndMedia {
            Every SwiftWebUI screen is a `View`. The `body`
            property describes the DOM the renderer should produce,
            and the `@ViewBuilder` result builder turns a block of
            declarations into a single returned value.

            A `Text` is the smallest leaf view: a single line of
            read-only text that renders to a `<div>` containing
            the same string.

            @Image(source: "placeholder.png", alt: "A code editor showing a SwiftWebUI view with a single Text.")
        }

        @Steps {
            @Step {
                Declare a `View` whose `body` returns a `Text`.

                @Code(name: "HelloWeb.swift", file: "hello-web-1.swift") {
                    import SwiftWebUI

                    struct Hello: View {
                        var body: some View {
                            Text("Hello, web")
                        }
                    }
                }
            }

            @Step {
                Stack a `Text` inside a `VStack` to add room for
                more lines.

                @Code(name: "HelloWeb.swift", file: "hello-web-2.swift") {
                    import SwiftWebUI

                    struct Hello: View {
                        var body: some View {
                            VStack {
                                Text("Hello, web")
                                Text("From Swift.")
                                    .foregroundStyle(.secondary)
                            }
                        }
                    }
                }
            }
        }
    }

    @Section(title: "Render it") {
        @ContentAndMedia {
            The `scripts/serve.sh` script builds the wasm, bundles
            the JS shim, and serves the host page. Opening the
            printed URL mounts the root view into the host page's
            container element, and the renderer patches the DOM to
            match the `body`.

            The visible result is a `<div>` containing the rendered
            `Text("Hello, web")` line. The exact DOM shape is owned
            by the renderer; the Swift side stays declarative.

            @Image(source: "placeholder.png", alt: "A browser window showing the rendered 'Hello, web' line.")
        }

        @Steps {
            @Step {
                Confirm `./scripts/serve.sh` is running and open
                the URL the script prints.

                @Code(name: "Terminal", file: "open-url.txt") {
                    open http://localhost:8000
                }
            }

            @Step {
                Inspect the rendered DOM in the browser's dev
                tools. The text appears inside a `<div>` nested
                inside the host page's mount node.

                @Code(name: "Browser dev tools", file: "dom.txt") {
                    <div>
                        <div>Hello, web</div>
                        <div>From Swift.</div>
                    </div>
                }
            }
        }
    }
}
